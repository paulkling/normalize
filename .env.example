# ---- Public ----
DOMAIN=normalize.example.com                # used by Caddy for TLS
PUBLIC_URL=https://normalize.example.com    # origin used in magic-link redirects; https enables Secure cookies
PORT=3000
HOST=0.0.0.0

# ---- Database (Supabase Postgres via the connection pooler, dedicated app role) ----
# Session-mode pooler port 5432 or transaction-mode 6543 both work (prepared statements are disabled).
DATABASE_URL=postgresql://normalize_app:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Used only by `pnpm migrate`; needs rights to create tables, roles and policies (the postgres user).
MIGRATE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# ---- Supabase Auth (server-side only; never ship the service-role key to a browser) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Optional. If set, access tokens are verified with HS256; otherwise the project JWKS is used.
SUPABASE_JWT_SECRET=
IDENTITY_PROVIDER=supabase                   # "fake" is allowed only outside production

# ---- Inference ----
LLAMA_URL=http://llama:8080
MODEL_REVISION=q4_k_m-2026-08
INFERENCE_TIMEOUT_MS=15000
MAX_INPUT_TOKENS=500                          # blank disables the token cap (character cap still applies)

# ---- Secrets (generate with: openssl rand -base64 48) ----
KEY_PEPPER=
IP_HMAC_SECRET=
SESSION_SECRET=

MAGIC_LINK_PER_EMAIL_PER_HOUR=5
